# Local PostgreSQL. On Supabase, copy the Session pooler URL from Project > Connect.
DATABASE_URL=postgresql://teluria:change-me@localhost:5432/teluria
# Optional certificate path for TLS verification with sslmode=verify-full. Standard Supabase URLs work with sslmode=require.
DATABASE_CA_PATH=
DATABASE_POOL_SIZE=5
HOST=0.0.0.0
PORT=8000
TELURIA_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TELURIA_FRONTEND_URL=http://localhost:3000
TELURIA_OWNER_EMAIL=owner@example.com
TELURIA_TEST_MODE=0
# Used only by the one-time dry-run/import command.
TELURIA_SEED_PATH=../teluria-frontend/data/workspace-db.json
# Optional private inference artifacts; see config/models-storage.env.example.
# Without a bundle key, npm start retains normal local model discovery.
ARK_ENABLE_RESEARCH_MODELS=0
ARK_MODEL_BUCKET=ark-models
