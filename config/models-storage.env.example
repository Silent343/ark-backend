# Copy locally to .env.models (ignored by Git). Never send real keys in chat.
SUPABASE_URL=https://TU_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=REEMPLAZA_CON_CLAVE_SECRETA_DE_SERVIDOR
# Legacy alternative, only if needed: SUPABASE_SERVICE_ROLE_KEY=...
ARK_MODEL_BUCKET=ark-models
ARK_ENABLE_RESEARCH_MODELS=1
# Copy these two exact values from npm run models:prepare.
ARK_MODEL_BUNDLE_KEY=releases/REEMPLAZAR/bundle.json
ARK_MODEL_BUNDLE_SHA256=REEMPLAZAR_CON_HASH_SHA256_DE_64_CARACTERES
# Optional paid Render disk: mount /var/data, then set this cache path.
# ARK_MODELS_CACHE_DIR=/var/data/ark-model-cache
